task.spawn(function()
    pcall(function()
        local folder = Instance.new("Folder")
        folder.Name = "DarkHubUISounds"
        folder.Parent = SoundService

        local clickSound = Instance.new("Sound")
        clickSound.Name = "Click"
        clickSound.SoundId = "rbxassetid://135244211779631"
        clickSound.Volume = 0.35
        clickSound.PlaybackSpeed = 1
        clickSound.Parent = folder

        local toggleSound = Instance.new("Sound")
        toggleSound.Name = "Toggle"
        toggleSound.SoundId = "rbxassetid://135244211779631"
        toggleSound.Volume = 0.30
        toggleSound.PlaybackSpeed = 1.15
        toggleSound.Parent = folder

        local function playSound(template)
            local sound = template:Clone()
            sound.Parent = folder
            sound:Play()
            task.delay(3, function() if sound then sound:Destroy() end end)
        end

        task.wait(0.6)

        local function hookButton(obj)
            if not (obj:IsA("TextButton") or obj:IsA("ImageButton")) then return; end
            if obj:GetAttribute("DarkHubSoundHooked") then return; end
            obj:SetAttribute("DarkHubSoundHooked", true)

            obj.MouseButton1Click:Connect(function()
                local name = obj.Name:lower()
                local isToggle = name:find("toggle") or name:find("switch") or name:find("checkbox")
                playSound(isToggle and toggleSound or clickSound)
            end)

            obj.Activated:Connect(function()
                local name = obj.Name:lower()
                local isToggle = name:find("toggle") or name:find("switch") or name:find("checkbox")
                playSound(isToggle and toggleSound or clickSound)
            end)
        end

        local function hookAll()
            local fluentGui = CoreGui:FindFirstChild("Fluent") or CoreGui:FindFirstChild("FluentUI")
            if not fluentGui then return; end

            for _, obj in ipairs(fluentGui:GetDescendants()) do
                hookButton(obj)
            end

            fluentGui.DescendantAdded:Connect(function(obj)
                task.defer(function() hookButton(obj) end)
            end)
        end

        hookAll()
    end)
end)

