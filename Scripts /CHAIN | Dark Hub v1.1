local Toggle = Tabs.Visual:AddToggle("RoundTimer", { Title = "Timer", Default = false })
local timerGui, timerLabel, timerConnection
local valuesFolder = workspace:WaitForChild("GameStuff"):WaitForChild("Values")

local function createTimer()
    if timerGui then return; end
    timerGui = Instance.new("ScreenGui")
    timerGui.IgnoreGuiInset = true
    timerGui.ResetOnSpawn = false
    timerGui.DisplayOrder = 100
    timerGui.Parent = CoreGui

    timerLabel = Instance.new("TextLabel")
    timerLabel.Size = UDim2.new(0, 100, 0, 40)
    timerLabel.Position = UDim2.new(0.5, -50, 0, 8)
    timerLabel.BackgroundTransparency = 1
    timerLabel.TextColor3 = Color3.fromRGB(235, 235, 235)
    timerLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    timerLabel.TextStrokeTransparency = 0.25
    timerLabel.Font = Enum.Font.GothamBold
    timerLabel.TextSize = 24
    timerLabel.Text = "--:--"
    timerLabel.Parent = timerGui

    local function update()
        if not timerLabel then return; end
        local v = valuesFolder:GetAttribute("RoundTime")
        if typeof(v) ~= "number" then timerLabel.Text = "--:--" return; end
        v = math.max(0, math.floor(v))
        timerLabel.Text = string.format("%02d:%02d", math.floor(v / 60), v % 60)
        timerLabel.TextColor3 = v <= 30 and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(235, 235, 235)
    end
    update()
    timerConnection = valuesFolder:GetAttributeChangedSignal("RoundTime"):Connect(update)
end

local function removeTimer()
    if timerConnection then
        timerConnection:Disconnect();
        timerConnection = nil;
    end
    if timerGui then
        timerGui:Destroy();
        timerGui = nil;
        timerLabel = nil;
    end
end

