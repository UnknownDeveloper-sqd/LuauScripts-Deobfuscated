    if Toggle.Value then
        espRunning = true
        task.spawn(function()
            local player = game.Players.LocalPlayer
            local misc = workspace:FindFirstChild("Misc")
    local ai = misc and misc:FindFirstChild("AI")
    local chain = ai and ai:FindFirstChild("CHAIN")
            local red = Color3.fromRGB(180, 0, 0)
            local chainPart = chain:IsA("BasePart") and chain or chain:FindFirstChildWhichIsA("BasePart", true)
            if not chainPart then return; end

            local highlight = Instance.new("Highlight")
            highlight.FillColor = red
            highlight.OutlineColor = red
            highlight.FillTransparency = 0.45
            highlight.OutlineTransparency = 0
            highlight.Adornee = chain
            highlight.Parent = chain

            local gui = Instance.new("BillboardGui")
