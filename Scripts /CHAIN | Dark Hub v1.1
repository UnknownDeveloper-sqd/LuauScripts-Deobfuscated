Tabs.Item:AddButton({
    Title = "Give Crucifix",
    Callback = function()
        Window:Dialog({
            Title = "Item Give",
            Content = "Give Crucifix?",
            Buttons = {
                { Title = "Confirm", Callback = function()
                    local RS = game:GetService("ReplicatedStorage")
                    local LP = Players.LocalPlayer
                    local function getIngame() local pg = LP:FindFirstChild("PlayerGui") return pg and pg:FindFirstChild("Ingame") end
                    local function getInventory() local ing = getIngame() return ing and ing:FindFirstChild("Inventory") end
                    local function hasItem(name)
                        local inv = getInventory()
                        if not inv then return false; end
                        for _, child in ipairs(inv:GetChildren()) do
                            if child:IsA("ImageLabel") then
                                local v = child:FindFirstChild("Values")
                                local itemName = v and v:FindFirstChild("ItemName")
                                if itemName and itemName.Value == name then return true; end
                            end
                        end
                        return false
                    end
                    local function hasAnyItem()
                        local inv = getInventory()
                        if not inv then return false; end
                        for _, child in ipairs(inv:GetChildren()) do
                            if child:IsA("ImageLabel") then return true; end
                        end
                        return false
                    end
                    local function getSlots()
                        local inv = getInventory()
                        local t = {}
                        if not inv then return t; end
                        for _, child in ipairs(inv:GetChildren()) do
                            if child:IsA("ImageLabel") then t[child.Name] = child; end
                        end
                        return t
                    end
                    local function freeSlot()
                        local slots = getSlots()
                        for _, v in ipairs({"1","2","3","4","5","6","7","8","9","0"}) do
                            if not slots[v] then return v; end
                        end
                        return nil
                    end
                    local function giveItem(itemName)
                        local ing = getIngame()
                        local inv = getInventory()
                        if not ing or not inv then return; end
                        if hasItem(itemName) then return; end
                        if not hasAnyItem() then return; end
                        local slot = freeSlot()
                        if not slot then return; end
                        local contents = ing:FindFirstChild("Contents")
                        local assets = contents and contents:FindFirstChild("Assets")
                        local slotItem = assets and assets:FindFirstChild("SlotItem")
                        if not slotItem then return; end
                        local info = RS:FindFirstChild("GameStuff")
                        info = info and info:FindFirstChild("ItemInfo")
                        info = info and info:FindFirstChild(itemName)
                        local iconID = info and info:GetAttribute("IconID") or ""
                        local clone = slotItem:Clone()
                        clone.Name = slot
                        clone.Parent = inv
                        clone.Values.ItemName.Value = itemName
                        clone.Icon.Image = tostring(iconID)
                        clone.Icon.Size = UDim2.new(1, 0, 1, 0)
                        clone.Visible = true
                        local char = LP.Character
                        local its = char and char:FindFirstChild("Items")
                        if its then its:SetAttribute(itemName, true); end
                    end
                    giveItem("Crucifix")
                end },
                { Title = "Cancel", Callback = function() end }
            }
        })
    end
})

