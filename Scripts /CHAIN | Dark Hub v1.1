local Toggle = Tabs.Player:AddToggle("JumpAnimFix", { Title = "Unlock Jump", Default = false })
local jumpConnection = nil
local stateConnection = nil
local animConnections = {}
local defaultJumpPower = 50
local defaultJumpHeight = 7.2
local BLOCKED_ANIMS = {"JumpAnim","FallAnim","FreeFall","Jumping","Falling"}

local function blockAnimator(humanoid)
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    return animator
end

local function lowerJumpAnimations(humanoid)
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return; end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        local anim = track.Animation
        if anim then
            local name = anim.Name
            for _, blocked in ipairs(BLOCKED_ANIMS) do
                if name:lower():find(blocked:lower()) then
                    pcall(function() track:AdjustWeight(0, 0) end)
                    break
                end
            end
        end
    end
end

local function applyJumpFix(humanoid)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Landed, true)
    blockAnimator(humanoid)
    if stateConnection then stateConnection:Disconnect(); end
    stateConnection = humanoid.StateChanged:Connect(function(_, newState)
        if newState == Enum.HumanoidStateType.Jumping
            or newState == Enum.HumanoidStateType.Freefall
            or newState == Enum.HumanoidStateType.Landed then
            lowerJumpAnimations(humanoid)
        end
    end)
end

local function keepCustomAnimations(humanoid)
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return; end
    local conn = animator.AnimationPlayed:Connect(function(track)
        local name = track.Animation and track.Animation.Name or ""
        for _, blocked in ipairs(BLOCKED_ANIMS) do
            if name:lower():find(blocked:lower()) then
                task.defer(function()
                    pcall(function()
                        track:AdjustWeight(0, 0)
                        track:Stop(0)
                    end)
                end)
                return
            end
        end
        pcall(function() track.Priority = Enum.AnimationPriority.Action4 end)
    end)
    table.insert(animConnections, conn)
end

Toggle:OnChanged(function()
    if Toggle.Value then
        if jumpConnection then jumpConnection:Disconnect(); end
        if stateConnection then stateConnection:Disconnect(); end
        for _, c in ipairs(animConnections) do c:Disconnect() end
        animConnections = {}

        jumpConnection = RunService.Heartbeat:Connect(function()
            local character = Players.LocalPlayer.Character
            if not character then return; end
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if not humanoid then return; end
            if humanoid.UseJumpPower == false then humanoid.UseJumpPower = true; end
            if humanoid.JumpPower ~= defaultJumpPower then humanoid.JumpPower = defaultJumpPower; end
            if humanoid.JumpHeight ~= defaultJumpHeight then humanoid.JumpHeight = defaultJumpHeight; end
        end)

        local LP = Players.LocalPlayer
        local function onChar(char)
            local humanoid = char:WaitForChild("Humanoid", 5)
            if not humanoid then return; end
            applyJumpFix(humanoid)
            keepCustomAnimations(humanoid)
        end

        if LP.Character then onChar(LP.Character); end
        LP.CharacterAdded:Connect(onChar)
    else
        if jumpConnection then
            jumpConnection:Disconnect();
            jumpConnection = nil;
        end
        if stateConnection then
            stateConnection:Disconnect();
            stateConnection = nil;
        end
        for _, c in ipairs(animConnections) do c:Disconnect() end
        animConnections = {}
    end
end)
Toggle:SetValue(false)

