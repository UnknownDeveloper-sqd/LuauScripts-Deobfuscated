            Fluent:Notify({ Title = "Music", Content = "Enter a name for the track.", Duration = 3 })
            return
        end
        if not id or id == "" then
            Fluent:Notify({ Title = "Music", Content = "Load a track first.", Duration = 3 })
            return
        end
        savedTracks[name] = id
        table.insert(savedDropdownValues, name)
        MusicSavedDropdown:Refresh(savedDropdownValues)
        Fluent:Notify({ Title = "Music", Content = "Saved track: " .. name, Duration = 3 })
    end
})

Tabs.Music:AddButton({
    Title = "Delete Selected",
    Callback = function()
        local selected = MusicSavedDropdown.Value
        if not selected or not savedTracks[selected] then
            Fluent:Notify({ Title = "Music", Content = "Select a saved track first.", Duration = 3 })
            return
        end
        savedTracks[selected] = nil
        for i, v in ipairs(savedDropdownValues) do
            if v == selected then
                table.remove(savedDropdownValues, i)
                break
            end
        end
        MusicSavedDropdown:Refresh(savedDropdownValues)
        Fluent:Notify({ Title = "Music", Content = "Removed: " .. selected, Duration = 3 })
    end
})

