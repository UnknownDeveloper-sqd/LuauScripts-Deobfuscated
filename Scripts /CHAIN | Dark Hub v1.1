local Toggle = Tabs.Visual:AddToggle("NoFog", { Title = "No Fog", Default = false })
local running = false
local fogConns = {}
local oldFogEnd = nil
local oldDensity = {}

Toggle:OnChanged(function()
    if Toggle.Value then
        running = true
        local Lighting = game:GetService("Lighting")
        oldFogEnd = Lighting.FogEnd
        table.clear(oldDensity)
        local function setupAtmosphere(v)
            if not oldDensity[v] then oldDensity[v] = v.Density; end
            v.Density = 0
        end
        Lighting.FogEnd = 100000
        fogConns.fog = Lighting:GetPropertyChangedSignal("FogEnd"):Connect(function()
            if running then Lighting.FogEnd = 100000; end
        end)
        for _, v in ipairs(Lighting:GetDescendants()) do
            if v:IsA("Atmosphere") then
                setupAtmosphere(v)
                fogConns[v] = v:GetPropertyChangedSignal("Density"):Connect(function()
                    if running then v.Density = 0; end
                end)
            end
        end
    else
        running = false
        for _, connection in pairs(fogConns) do
            if typeof(connection) == "RBXScriptConnection" then connection:Disconnect(); end
        end
        table.clear(fogConns)
        local Lighting = game:GetService("Lighting")
        if oldFogEnd then Lighting.FogEnd = oldFogEnd; end
        for atmosphere, density in pairs(oldDensity) do
            if atmosphere and atmosphere.Parent then atmosphere.Density = density; end
        end
        table.clear(oldDensity)
    end
end)
Toggle:SetValue(false)

local Toggle = Tabs.Visual:AddToggle("FullBright", { Title = "Fullbright", Default = false })
local fullbrightRunning = false
local fullbrightConnections = {}
local oldLighting = {}

Toggle:OnChanged(function()
    local Lighting = game:GetService("Lighting")
    if Toggle.Value then
        if fullbrightRunning then return; end
        fullbrightRunning = true
        oldLighting.Brightness = Lighting.Brightness
        oldLighting.ClockTime = Lighting.ClockTime
        oldLighting.FogEnd = Lighting.FogEnd
        oldLighting.GlobalShadows = Lighting.GlobalShadows
        oldLighting.Ambient = Lighting.Ambient
        oldLighting.OutdoorAmbient = Lighting.OutdoorAmbient
        local function apply()
            if not fullbrightRunning then return; end
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.FogEnd = 100000
            Lighting.GlobalShadows = false
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        end
        apply()
        for _, property in ipairs({"Brightness","ClockTime","FogEnd","GlobalShadows","Ambient","OutdoorAmbient"}) do
            fullbrightConnections[property] = Lighting:GetPropertyChangedSignal(property):Connect(apply)
        end
    else
        fullbrightRunning = false
        for _, connection in pairs(fullbrightConnections) do
            if typeof(connection) == "RBXScriptConnection" then connection:Disconnect(); end
        end
        table.clear(fullbrightConnections)
        for property, value in pairs(oldLighting) do Lighting[property] = value end
        table.clear(oldLighting)
    end
end)
