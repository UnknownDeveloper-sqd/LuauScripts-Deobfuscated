local AimbotToggle = Tabs.Player:AddToggle("ChainAimbot", { Title = "Aimbot", Default = false })

do
    local Workspace = game:GetService("Workspace")
    local UserInputService = game:GetService("UserInputService")
    local Camera = Workspace.CurrentCamera
    local AIFolder = Workspace:WaitForChild("Misc"):WaitForChild("AI")

    local AimbotEnabled = false
    local RightMouseDown = false
    local CHAIN

    local function lookAt(targetCFrame)
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetCFrame.Position)
    end

    local function getChain()
        if CHAIN and CHAIN.Parent then return CHAIN; end
        for _, child in ipairs(AIFolder:GetChildren()) do
            if child:FindFirstChild("HumanoidRootPart") then return child; end
        end
        return nil
    end

    local function onRender()
        if AimbotEnabled and RightMouseDown then
            CHAIN = getChain()
            if CHAIN then lookAt(CHAIN:GetPivot()); end
        else
            CHAIN = nil
        end
    end

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return; end
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            RightMouseDown = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            RightMouseDown = false
        end
    end)

    RunService.RenderStepped:Connect(onRender)

    AimbotToggle:OnChanged(function()
        AimbotEnabled = AimbotToggle.Value == true
    end)
end

local PerfBoosterToggle = Tabs.Player:AddToggle("PerformanceBooster", { Title = "Performance Booster", Default = false })

do
    local Lighting = game:GetService("Lighting")
    local UserGameSettings = UserSettings():GetService("UserGameSettings")

    local originalSettings = {}
    local settingsSaved = false

    local function saveOriginalSettings()
        if settingsSaved then return; end
        originalSettings.Technology = Lighting.Technology
        originalSettings.GlobalShadows = Lighting.GlobalShadows
        originalSettings.FogEnd = Lighting.FogEnd
        originalSettings.QualityLevel = UserGameSettings.SavedQualityLevel
        originalSettings.effects = {}
        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then
                originalSettings.effects[effect] = effect.Enabled
            end
        end
        settingsSaved = true
    end

    local function applyPerformanceMode()
        saveOriginalSettings()
        Lighting.Technology = Enum.Technology.Compatibility
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        UserGameSettings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then
                effect.Enabled = false
            end
        end
    end

    local function restoreOriginalSettings()
        if not settingsSaved then return; end
        Lighting.Technology = originalSettings.Technology
        Lighting.GlobalShadows = originalSettings.GlobalShadows
        Lighting.FogEnd = originalSettings.FogEnd
        UserGameSettings.SavedQualityLevel = originalSettings.QualityLevel
        for effect, wasEnabled in pairs(originalSettings.effects) do
            pcall(function()
                if effect and effect.Parent then
                    effect.Enabled = wasEnabled
                end
            end)
        end
    end

    PerfBoosterToggle:OnChanged(function()
        if PerfBoosterToggle.Value then
            applyPerformanceMode()
        else
            restoreOriginalSettings()
        end
    end)
end

local NoclipToggle = Tabs.Player:AddToggle("Noclip", { Title = "Noclip", Default = false })

do
    local LP = Players.LocalPlayer
