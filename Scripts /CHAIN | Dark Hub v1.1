local InstantHealToggle = Tabs.Item:AddToggle("InstantHeal", { Title = "Instant Medkit & Soda", Default = false })

do
    local RS = game:GetService("ReplicatedStorage")
    local LP = Players.LocalPlayer
    local conns = {}
    local HEAL_ANIMS = {"MedkitHealSelf","MedkitHealOther","SodaDrink","Pills"}

    local function clearConns()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
    end

    local function hookHumanoid(humanoid)
        if not humanoid then return; end
        local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
        table.insert(conns, animator.AnimationPlayed:Connect(function(track)
            if not InstantHealToggle.Value then return; end
            local id = track.Animation and track.Animation.AnimationId
            if not id then return; end
            for _, name in ipairs(HEAL_ANIMS) do
                local item = RS:FindFirstChild("GameStuff")
                    and RS.GameStuff:FindFirstChild("ItemAnimations")
                    and RS.GameStuff.ItemAnimations:FindFirstChild(name)
                if item and item.AnimationId == id then
                    pcall(function() track:Stop() end)
                    break
                end
            end
        end))
    end

    local function hookCharacter(char)
        if not char then return; end
        local humanoid = char:WaitForChild("Humanoid", 5)
        if humanoid then hookHumanoid(humanoid); end
    end

    InstantHealToggle:OnChanged(function()
        clearConns()
        if not InstantHealToggle.Value then return; end
        local char = LP.Character
        if char then hookCharacter(char); end
        table.insert(conns, LP.CharacterAdded:Connect(function(c)
            if InstantHealToggle.Value then hookCharacter(c); end
        end))
    end)
end

local InfCombatKnifeToggle = Tabs.Item:AddToggle("InfCombatKnife", { Title = "Infinite Combat Knife", Default = false })

do
