local Toggle = Tabs.Visual:AddToggle("ScrapESP", { Title = "Scrap Esp", Default = false })

local player = Players.LocalPlayer
local misc = workspace:FindFirstChild("Misc")
local zones = misc and misc:FindFirstChild("Zones")
local looting = zones and zones:FindFirstChild("LootingItems")
local scrapFolder = looting and looting:FindFirstChild("Scrap")

local espRunning4 = false
local connections = {}
local labels = {}
local highlights = {}
local gui
local blue = Color3.fromRGB(0, 130, 160)

local function getAvailable(scrap)
    local values = scrap:FindFirstChild("Values")
    if not values then return false; end
    return values:GetAttribute("Available")
end

local function removeScrap(scrap)
    if labels[scrap] then
        labels[scrap]:Destroy();
        labels[scrap] = nil;
    end
    if highlights[scrap] then
        highlights[scrap]:Destroy();
        highlights[scrap] = nil;
    end
end

local function addScrap(scrap)
    if not espRunning4 or labels[scrap] then return; end
    if scrap:GetAttribute("Scrap") == nil then return; end
    if not scrap:FindFirstChild("Values") then return; end

    local highlight = Instance.new("Highlight")
    highlight.FillColor = blue
    highlight.OutlineColor = blue
    highlight.FillTransparency = 0.45
    highlight.OutlineTransparency = 0
    highlight.Adornee = scrap
    highlight.Enabled = false
    highlight.Parent = scrap
    highlights[scrap] = highlight

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 120, 0, 35)
    label.AnchorPoint = Vector2.new(0.5, 0.5)
    label.BackgroundTransparency = 1
    label.TextColor3 = blue
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.Visible = false
    label.Parent = gui
    labels[scrap] = label
end

Toggle:OnChanged(function()
    if Toggle.Value then
        if espRunning4 then return; end
        espRunning4 = true
        gui = Instance.new("ScreenGui")
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 10
        gui.Parent = CoreGui

        for _, scrap in ipairs(scrapFolder:GetChildren()) do addScrap(scrap) end

        connections.added = scrapFolder.ChildAdded:Connect(function(scrap)
            task.defer(function() if espRunning4 then addScrap(scrap) end end)
        end)
        connections.removed = scrapFolder.ChildRemoved:Connect(function(scrap) removeScrap(scrap) end)

        connections.render = RunService.RenderStepped:Connect(function()
            if not espRunning4 then return; end
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local camera = workspace.CurrentCamera
            if not root or not camera then return; end

            for scrap, label in pairs(labels) do
                if not scrap.Parent then
                    removeScrap(scrap);
                    continue;
                end
                local highlight = highlights[scrap]
                local available = getAvailable(scrap)
                if not available then
                    label.Visible = false
                    if highlight then highlight.Enabled = false; end
                    continue
                end

                local success, pivot = pcall(function() return scrap:GetPivot() end)
                if not success then
                    label.Visible = false
                    if highlight then highlight.Enabled = false; end
                    continue
                end

                local position, visible = camera:WorldToViewportPoint(pivot.Position)
                if visible then
                    local distance = math.floor((root.Position - pivot.Position).Magnitude + 0.5)
                    label.Text = "Scrap\n" .. distance .. " studs"
                    label.Position = UDim2.fromOffset(position.X, position.Y)
                    label.Visible = true
                    if highlight then highlight.Enabled = true; end
                else
                    label.Visible = false
                    if highlight then highlight.Enabled = false; end
                end
            end
        end)
    else
        espRunning4 = false
        for _, connection in pairs(connections) do
            if typeof(connection) == "RBXScriptConnection" then connection:Disconnect(); end
        end
        table.clear(connections)
        for scrap, label in pairs(labels) do if label then label:Destroy() end end
        for scrap, highlight in pairs(highlights) do if highlight then highlight:Destroy() end end
        table.clear(labels)
        table.clear(highlights)
        if gui then
            gui:Destroy();
            gui = nil;
        end
    end
end)
Toggle:SetValue(false)

